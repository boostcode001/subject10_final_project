# PostgreSQL
POSTGRES_DB=vision_action
POSTGRES_USER=vision_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# FastAPI
FASTAPI_BASE_URL=http://localhost:8001

# Camera 허용 목록 (이름=주소, 여러 개는 쉼표로 구분)
CAMERA_SOURCES=droidcam=http://<휴대폰_IP>:4747/video

# 참고: docker compose로 실행하면 POSTGRES_HOST·REDIS_URL·FASTAPI_BASE_URL·DJANGO_DEBUG는
# compose.yaml의 environment가 서비스 이름(postgres·redis·fastapi)과 False로 덮어씀.
# 이 파일의 localhost 값은 로컬 개발(runserver)용.